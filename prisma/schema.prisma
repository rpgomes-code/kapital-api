// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==========================
// USERS & IDENTITY
// ==========================

model User {
  id            String    @id @default(uuid())
  username      String?
  email         String    @unique
  name          String?
  image         String?   // Used by Better Auth for profile picture
  country       String?
  mainCurrency  String    @default("USD") @map("main_currency")
  emailVerified Boolean   @default(false) @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  roleId      Int?          @map("role_id")
  role        Role?         @relation(fields: [roleId], references: [id])
  userBrokers UserBroker[]
  watchlists  Watchlist[]
  tags        Tag[]
  sessions    Session[]
  accounts    AuthAccount[]

  // Portfolio Analytics
  portfolioSnapshots PortfolioSnapshot[]
  priceAlerts        PriceAlert[]

  @@map("users")
}

// ==========================
// AUTHENTICATION (Better Auth)
// ==========================

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model AuthAccount {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_accounts")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@map("verifications")
}

// ==========================
// ROLES & PERMISSIONS
// ==========================

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?
  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@map("role_permissions")
}

// ==========================
// BROKERS & ACCOUNTS
// ==========================

model Broker {
  id          Int          @id @default(autoincrement())
  publicId    String       @unique @default(uuid()) @map("public_id")
  acronym     String?
  name        String
  logo        String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  userBrokers UserBroker[]

  @@map("brokers")
}

model UserBroker {
  id        Int       @id @default(autoincrement())
  userId    String    @map("user_id")
  brokerId  Int       @map("broker_id")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])
  broker    Broker    @relation(fields: [brokerId], references: [id])
  accounts  Account[]

  @@map("user_brokers")
}

model Account {
  id           Int           @id @default(autoincrement())
  publicId     String        @unique @default(uuid()) @map("public_id")
  userBrokerId Int           @map("user_broker_id")
  name         String
  currency     String        @default("USD")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  userBroker   UserBroker    @relation(fields: [userBrokerId], references: [id])
  transactions Transaction[]

  @@map("accounts")
}

// ==========================
// ASSETS & CLASSIFICATION
// ==========================

model Sector {
  id         Int        @id @default(autoincrement())
  name       String
  industries Industry[]
  assets     Asset[]

  @@map("sectors")
}

model Industry {
  id       Int     @id @default(autoincrement())
  sectorId Int     @map("sector_id")
  name     String
  sector   Sector  @relation(fields: [sectorId], references: [id])
  assets   Asset[]

  @@map("industries")
}

enum AssetType {
  STOCK
  ETF
  CRYPTO
  FUND
}

model Asset {
  id          Int       @id @default(autoincrement())
  publicId    String    @unique @default(uuid()) @map("public_id")
  symbol      String
  yahooSymbol String    @map("yahoo_symbol")
  isin        String?
  cusip       String?
  name        String
  assetType   AssetType @map("asset_type")
  exchange    String?
  currency    String

  sectorId   Int?      @map("sector_id")
  industryId Int?      @map("industry_id")
  sector     Sector?   @relation(fields: [sectorId], references: [id])
  industry   Industry? @relation(fields: [industryId], references: [id])

  transactions     Transaction[]
  assetPrices      AssetPrice[]
  corporateActions CorporateAction[]
  watchlistAssets  WatchlistAsset[]

  // Portfolio Analytics
  holdingSnapshots HoldingSnapshot[]
  priceAlerts      PriceAlert[]

  // Asset Enrichment
  enrichmentLog AssetEnrichmentLog?

  @@map("assets")
}

// ==========================
// TRANSACTIONS
// ==========================

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  FEE
  TAX
}

model Transaction {
  id         Int             @id @default(autoincrement())
  publicId   String          @unique @default(uuid()) @map("public_id")
  accountId  Int             @map("account_id")
  assetId    Int             @map("asset_id")
  type       TransactionType
  quantity   Decimal         @db.Decimal(18, 8)
  price      Decimal         @db.Decimal(18, 8)
  currency   String
  fee        Decimal?        @default(0) @db.Decimal(18, 8)
  tax        Decimal?        @default(0) @db.Decimal(18, 8)
  executedAt DateTime        @map("executed_at")
  createdAt  DateTime        @default(now()) @map("created_at")

  account Account          @relation(fields: [accountId], references: [id])
  asset   Asset            @relation(fields: [assetId], references: [id])
  tags    TransactionTag[]

  @@map("transactions")
}

// ==========================
// MARKET DATA & EXTRAS
// ==========================

model AssetPrice {
  id       Int      @id @default(autoincrement())
  assetId  Int      @map("asset_id")
  date     DateTime @db.Date
  open     Decimal  @db.Decimal(18, 4)
  close    Decimal  @db.Decimal(18, 4)
  high     Decimal  @db.Decimal(18, 4)
  low      Decimal  @db.Decimal(18, 4)
  volume   BigInt
  currency String
  asset    Asset    @relation(fields: [assetId], references: [id])

  @@unique([assetId, date])
  @@map("asset_prices")
}

// ==========================
// CORPORATE ACTIONS
// ==========================

enum CorporateActionType {
  SPLIT
  REVERSE_SPLIT
  DIVIDEND
  SPECIAL_DIVIDEND
  SPINOFF
  MERGER
  SYMBOL_CHANGE
}

model CorporateAction {
  id          Int                 @id @default(autoincrement())
  assetId     Int                 @map("asset_id")
  type        CorporateActionType
  value       Decimal             @db.Decimal(18, 8)
  executedAt  DateTime            @map("executed_at")
  recordDate  DateTime?           @map("record_date")
  exDate      DateTime?           @map("ex_date")
  paymentDate DateTime?           @map("payment_date")
  description String?
  isProcessed Boolean             @default(false) @map("is_processed")
  processedAt DateTime?           @map("processed_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  asset       Asset               @relation(fields: [assetId], references: [id])

  @@index([assetId, executedAt])
  @@index([type, isProcessed])
  @@map("corporate_actions")
}

model Watchlist {
  id        Int              @id @default(autoincrement())
  publicId  String           @unique @default(uuid()) @map("public_id")
  userId    String           @map("user_id")
  name      String
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id])
  assets    WatchlistAsset[]

  @@map("watchlists")
}

model WatchlistAsset {
  id          Int       @id @default(autoincrement())
  watchlistId Int       @map("watchlist_id")
  assetId     Int       @map("asset_id")
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id])
  asset       Asset     @relation(fields: [assetId], references: [id])

  @@map("watchlist_assets")
}

model Benchmark {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid()) @map("public_id")
  name     String
  symbol   String
  currency String

  @@map("benchmarks")
}

model Tag {
  id              Int              @id @default(autoincrement())
  userId          String           @map("user_id")
  name            String
  user            User             @relation(fields: [userId], references: [id])
  transactionTags TransactionTag[]

  @@map("tags")
}

model TransactionTag {
  transactionId Int         @map("transaction_id")
  tagId         Int         @map("tag_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  tag           Tag         @relation(fields: [tagId], references: [id])

  @@id([transactionId, tagId])
  @@map("transaction_tags")
}

// ==========================
// PORTFOLIO ANALYTICS
// ==========================

model PortfolioSnapshot {
  id          Int               @id @default(autoincrement())
  userId      String            @map("user_id")
  date        DateTime          @db.Date
  totalValue  Decimal           @map("total_value") @db.Decimal(18, 2)
  totalCost   Decimal           @map("total_cost") @db.Decimal(18, 2)
  dayChange   Decimal           @map("day_change") @db.Decimal(18, 2)
  cashBalance Decimal           @default(0) @map("cash_balance") @db.Decimal(18, 2)
  createdAt   DateTime          @default(now()) @map("created_at")
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings    HoldingSnapshot[]

  @@unique([userId, date])
  @@index([userId])
  @@map("portfolio_snapshots")
}

model HoldingSnapshot {
  id         Int               @id @default(autoincrement())
  snapshotId Int               @map("snapshot_id")
  assetId    Int               @map("asset_id")
  quantity   Decimal           @db.Decimal(18, 8)
  price      Decimal           @db.Decimal(18, 4)
  value      Decimal           @db.Decimal(18, 2)
  costBasis  Decimal           @map("cost_basis") @db.Decimal(18, 2)
  snapshot   PortfolioSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  asset      Asset             @relation(fields: [assetId], references: [id])

  @@index([snapshotId])
  @@map("holding_snapshots")
}

// ==========================
// PRICE ALERTS
// ==========================

enum AlertType {
  PRICE_ABOVE
  PRICE_BELOW
  PERCENT_UP
  PERCENT_DOWN
  VOLUME_SPIKE
}

model PriceAlert {
  id          Int       @id @default(autoincrement())
  userId      String    @map("user_id")
  assetId     Int       @map("asset_id")
  type        AlertType
  targetValue Decimal   @map("target_value") @db.Decimal(18, 4)
  isActive    Boolean   @default(true) @map("is_active")
  triggeredAt DateTime? @map("triggered_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset       Asset     @relation(fields: [assetId], references: [id])

  @@index([userId])
  @@index([assetId])
  @@map("price_alerts")
}

// ==========================
// PRICE CACHING
// ==========================

model PriceCache {
  id        Int      @id @default(autoincrement())
  symbol    String
  date      DateTime @db.Date
  open      Decimal  @db.Decimal(18, 4)
  high      Decimal  @db.Decimal(18, 4)
  low       Decimal  @db.Decimal(18, 4)
  close     Decimal  @db.Decimal(18, 4)
  adjClose  Decimal  @map("adj_close") @db.Decimal(18, 4)
  volume    BigInt
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([symbol, date])
  @@index([symbol])
  @@map("price_cache")
}

// ==========================
// ASSET ENRICHMENT
// ==========================

enum EnrichmentStatus {
  PENDING
  SUCCESS
  FAILED
  DELISTED
}

model AssetEnrichmentLog {
  id           Int              @id @default(autoincrement())
  assetId      Int              @unique @map("asset_id")
  lastEnriched DateTime?        @map("last_enriched")
  status       EnrichmentStatus @default(PENDING)
  errorMessage String?          @map("error_message")
  retryCount   Int              @default(0) @map("retry_count")
  asset        Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_enrichment_logs")
}

// ==========================
// SCHEDULED JOBS
// ==========================

enum JobStatus {
  RUNNING
  COMPLETED
  FAILED
}

model JobRun {
  id             Int       @id @default(autoincrement())
  jobName        String    @map("job_name")
  status         JobStatus
  startedAt      DateTime  @map("started_at")
  completedAt    DateTime? @map("completed_at")
  itemsProcessed Int?      @map("items_processed")
  errorMessage   String?   @map("error_message")
  metadata       Json?

  @@index([jobName, startedAt])
  @@map("job_runs")
}
